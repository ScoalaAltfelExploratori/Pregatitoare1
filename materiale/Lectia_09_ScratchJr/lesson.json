  "missions": [
    {
      "label": "Misiunea 1",
      "title": "Insula reacționează",
      "subtitle": "Două atingeri. Două surprize diferite.",
      "diagram": "reactions",
      "steps": [
        "Fluturele devine mare o clipă, apoi revine la mărimea inițială.",
        "Câinele dispare o clipă și reapare singur. Celălalt personaj nu se schimbă.",
        "Probează fiecare surpriză de două ori. Nu folosi Reset."
      ],
      "success": "Ambele reacții se termină și sunt gata pentru încă o încercare."
    },
    {
      "label": "Misiunea 2",
      "title": "Ieșirea ascunsă",
      "subtitle": "Descoperă un lucru nou pe care îl poți atinge.",
      "diagram": "exit",
      "steps": [
        "La steag, mingea este ascunsă. Un tap pe fluture o face vizibilă.",
        "Mingea te duce pe pagina de final. Acolo o altă minge te aduce înapoi.",
        "La întoarcere, ieșirea trebuie să fie iar ascunsă. Descoper-o din nou."
      ],
      "success": "Descoperire, final, întoarcere. Jocul este pregătit pentru încă o rundă."
    },
    {
      "label": "Misiunea 3 - dificilă",
      "title": "Lanțul descoperirilor",
      "subtitle": "Fiecare descoperire deschide pasul următor.",
      "diagram": "chain",
      "steps": [
        "După steag vezi numai fluturele. Câinele și mingea sunt ascunși.",
        "Fluture → apare câinele. Câine → apare mingea. Minge → pagina de final.",
        "Revino cu mingea de pe final și joacă din nou, fără Reset sau un nou steag."
      ],
      "success": "Doi pași de descoperire, în ordine. Două runde complete."
    },
    {
      "label": "Rezervă 1 - 6-8 minute",
      "title": "Surpriza opțională",
      "subtitle": "Adaugă ceva distractiv care păstrează misterul.",
      "diagram": "surprise",
      "steps": [
        "Pornește de la lanțul dificil. Adaugă un iepure vizibil, separat de celelalte personaje.",
        "La atingere, iepurele face un truc și revine la normal. Nu dezvăluie câinele sau mingea.",
        "Încearcă trucul înaintea descoperirilor și după întoarcere. Lanțul trebuie să funcționeze."
      ],
      "success": "Trucul poate fi repetat. Descoperirile rămân în ordinea corectă."
    },
    {
      "label": "Rezervă 2 - 8-10 minute",
      "title": "Două drumuri",
      "subtitle": "Două alegeri pot duce la aceeași ieșire.",
      "diagram": "dual",
      "steps": [
        "Revino la varianta M2: fluture și câine vizibili, minge ascunsă.",
        "Fă atât fluturele, cât și câinele să dezvăluie mingea. Este suficient oricare dintre ei.",
        "Testează drumul prin fluture. Revino și testează separat drumul prin câine."
      ],
      "success": "Fiecare alegere funcționează singură, pornind cu ieșirea ascunsă."
    }
  ]

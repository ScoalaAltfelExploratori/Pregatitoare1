{
  "lesson": 3,
  "title": "Atelierul de magie",
  "age": "6-7 ani",
  "duration": 50,
  "new_mechanics": [
    "onclick",
    "grow",
    "shrink",
    "hide",
    "show",
    "wait",
    "same"
  ],
  "assets": [
    "Rabbit.svg",
    "Dog.svg",
    "Butterfly.svg",
    "Park.svg"
  ],
  "missions": [
    {
      "label": "Misiunea 1",
      "title": "Uriaș și pitic",
      "subtitle": "Două personaje, două transformări. Ele rămân pe loc.",
      "diagram": "sizes",
      "steps": [
        "La o atingere, iepurele devine mai mare. La o atingere, câinele devine mai mic.",
        "Programul pornește când atingi personajul pe scenă. Celălalt nu se schimbă.",
        "Înainte de o probă nouă, apasă butonul de resetare a personajelor."
      ],
      "success": "Ating iepurele: crește. Ating câinele: se micșorează. Steagul nu pornește trucurile."
    },
    {
      "label": "Misiunea 2",
      "title": "Dispar și revin",
      "subtitle": "Un singur tap. Magia continuă chiar dacă nu mai vezi iepurele.",
      "diagram": "vanish",
      "steps": [
        "Atinge iepurele o singură dată: trebuie să dispară.",
        "Lasă-l ascuns aproximativ o secundă, apoi fă-l să reapară singur.",
        "Câinele rămâne neschimbat. Nu atinge ecranul și nu reseta în timpul trucului."
      ],
      "success": "Iepurele dispare, rămâne ascuns o clipă și revine singur, în același loc."
    },
    {
      "label": "Misiunea 3 - dificilă",
      "title": "Trucul complet",
      "subtitle": "Crește. Dispare. Revine la mărimea normală. Încă o dată!",
      "diagram": "complete",
      "steps": [
        "La o atingere, iepurele crește și rămâne mare o clipă.",
        "Apoi dispare, așteaptă ascuns și reapare direct la mărimea normală.",
        "După ce termină, atinge-l din nou. Trucul trebuie să funcționeze fără resetare."
      ],
      "success": "Mare → ascuns → vizibil și normal. Două rulări complete, fără mutare sau resetare."
    },
    {
      "label": "Rezervă 1 - 6-8 minute",
      "title": "Al treilea secret",
      "subtitle": "Adaugă un fluture din bibliotecă. Fiecare personaj are propriul truc.",
      "diagram": "third",
      "steps": [
        "Construiește o surpriză pentru fluture, pornită prin atingerea lui.",
        "Puzzle-ul exemplului: fluturele dispare și reapare de două ori, apoi rămâne vizibil.",
        "Când atingi fluturele, iepurele și câinele trebuie să rămână neschimbați."
      ],
      "success": "O atingere, două apariții. Numai personajul atins reacționează."
    },
    {
      "label": "Rezervă 2 - 8-10 minute",
      "title": "Magie în cinci blocuri",
      "subtitle": "Inventează un truc. Colegul prezice ce se va întâmpla.",
      "diagram": "five",
      "steps": [
        "Folosește cel mult 5 blocuri după pornirea la atingere. Așteptările se numără și ele.",
        "Arată cel puțin două schimbări vizibile. La final, personajul este vizibil și normal.",
        "Fără Repeat sau mișcare. Explică predicția și repetă trucul fără resetare."
      ],
      "success": "Cel mult 5 acțiuni. Două schimbări vizibile. Un truc care se poate repeta."
    }
  ],

  "exercises": [
    {
      "id": "meet",
      "title": "Fă-i să se întâlnească",
      "intro": "Două personaje vin din părți diferite. Se apropie și sar de bucurie.",
      "steps": [
        "Construiește câte un program pentru fiecare personaj.",
        "Pornește totul cu steagul verde de sus.",
        "Potrivește mișcările ca să se oprească aproape, fără să se acopere."
      ],
      "check": "Fiecare personaj are programul lui. Întâlnirea funcționează."
    },
    {
      "id": "return_puzzle",
      "title": "Două blocuri până acasă",
      "intro": "Se întâlnesc, sar și revin fiecare la locul de pornire. Totul la un singur steag!",
      "steps": [
        "Păstrează întâlnirea și săritura. Adaugă o singură săgeată albastră la fiecare personaj.",
        "Alege direcția și numărul. Fără mutare cu degetul sau resetare în timpul rulării.",
        "Mai greu: întoarce fiecare personaj cu două săgeți, cu numere diferite."
      ],
      "check": "Amândoi ajung exact la start. Pot explica direcția și distanța revenirii."
    },
    {
      "id": "create",
      "title": "Inventează finalul întâlnirii",
      "intro": "Ce fac prietenii după ce se întâlnesc?",
      "steps": [
        "Alege un final: încă o săritură, un mic dans sau o mișcare inventată de tine.",
        "Adaugă cel puțin o acțiune la unul dintre personaje.",
        "Arată unui coleg ce ai creat și explică un bloc."
      ],
      "check": "Proiectul are o idee a mea, nu doar un program copiat."
    }
  ],

  "missions": [
    {
      "label": "Misiunea 1",
      "title": "Portalul",
      "subtitle": "O acțiune, apoi altă scenă.",
      "diagram": "portal",
      "steps": [
        "Atinge iepurele: sare o dată, apoi ajunge la plaja de zi.",
        "Câinele așteaptă. Când îl atingi, sare o dată.",
        "Schimbă pagina prin program, fără miniaturile din dreapta."
      ],
      "success": "Vedem săritura iepurelui înainte să se schimbe scena."
    },
    {
      "label": "Misiunea 2",
      "title": "Dus-întors",
      "subtitle": "Un drum de plecare și unul de întoarcere.",
      "diagram": "return",
      "steps": [
        "Păstrează portalul și săritura câinelui.",
        "Adaugă pe plajă o minge care, la atingere, te întoarce în parc.",
        "Fă toată călătoria de două ori, numai prin personajele de pe scenă."
      ],
      "success": "Înapoi în parc, povestea așteaptă o nouă atingere."
    },
    {
      "label": "Misiunea 3 - dificilă",
      "title": "Două finaluri",
      "subtitle": "Alege. Explorează. Întoarce-te.",
      "diagram": "branch",
      "steps": [
        "În parc: iepurele deschide ziua, câinele deschide noaptea.",
        "Ziua: atinge câinele ca să sară. Noaptea: iepurele crește și revine la atingere.",
        "Fiecare final are o minge de întoarcere. Vizitează-le pe amândouă."
      ],
      "success": "Două alegeri, două acțiuni diferite și două drumuri înapoi."
    },
    {
      "label": "Rezervă 1 - 6-8 minute",
      "title": "Finalul pornește singur",
      "subtitle": "Alegerea ta pornește și acțiunea.",
      "diagram": "auto",
      "steps": [
        "Păstrează ambele finaluri și mingile de întoarcere.",
        "Când intri la zi, câinele sare singur. La noapte, iepurele crește și revine singur.",
        "Atinge numai alegerea din parc, apoi mingea pentru întoarcere."
      ],
      "success": "Finalul face acțiunea fără alt tap și rămâne deschis."
    },
    {
      "label": "Rezervă 2 - 8-10 minute",
      "title": "Trei opriri",
      "subtitle": "O atingere, trei scene, un final.",
      "diagram": "three",
      "steps": [
        "În parc, iepurele sare o dată. Pe plaja de zi, câinele sare de două ori.",
        "Pe plaja de noapte, iepurele crește și revine. Totul pornește dintr-un singur tap.",
        "Se oprește la noapte. Mingea revine în parc; o nouă atingere pornește din nou."
      ],
      "success": "1 săritură → 2 sărituri → transformare. Fără reluare automată."
    }
  ]
}

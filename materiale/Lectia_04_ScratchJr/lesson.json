  "missions": [
    {
      "label": "Misiunea 1",
      "title": "Magia la distanță",
      "subtitle": "Atingi iepurele. Câinele face trucul.",
      "diagram": "remote",
      "steps": [
        "La un tap pe iepure, câinele crește, rămâne mare o clipă și revine la normal.",
        "Iepurele nu se schimbă. Nu atinge câinele ca să pornească.",
        "Așteaptă finalul și repetă fără resetare."
      ],
      "success": "Un tap pe iepure. Trucul se vede numai la câine."
    },
    {
      "label": "Misiunea 2",
      "title": "Două butoane",
      "subtitle": "Același câine, două comenzi diferite.",
      "diagram": "two",
      "steps": [
        "Iepurele comandă mărirea câinelui și revenirea la normal.",
        "Fluturele comandă dispariția câinelui și revenirea lui automată.",
        "Alege două culori de mesaj. Testează pe rând; butoanele rămân neschimbate."
      ],
      "success": "Două personaje de atins. Două reacții diferite ale câinelui."
    },
    {
      "label": "Misiunea 3 - dificilă",
      "title": "Spectacolul în lanț",
      "subtitle": "Un singur tap. Trei artiști, pe rând.",
      "diagram": "chain",
      "steps": [
        "Iepurele crește și revine la normal. Abia apoi câinele dispare și reapare.",
        "După revenirea câinelui, fluturele crește și revine la normal.",
        "Atinge numai iepurele, la început. Repetă tot spectacolul fără resetare."
      ],
      "success": "Iepure → câine → fluture. Fără alte atingeri. Toți termină normali și vizibili."
    },
    {
      "label": "Rezervă 1 - 6-8 minute",
      "title": "Un semnal, două surprize",
      "subtitle": "Același plic poate porni doi artiști.",
      "diagram": "broadcast",
      "steps": [
        "La un tap pe iepure, câinele crește iar fluturele dispare o clipă.",
        "Folosește o singură culoare și un singur bloc de trimitere.",
        "Cele două trucuri pornesc împreună. La final, toți sunt normali și vizibili."
      ],
      "success": "Un expeditor. Doi destinatari. Două trucuri care se pot repeta."
    },
    {
      "label": "Rezervă 2 - 8-10 minute",
      "title": "De-a v-ați ascunselea",
      "subtitle": "Cum chemăm înapoi un personaj pe care nu-l mai vedem?",
      "diagram": "hide_seek",
      "steps": [
        "Un tap pe iepure ascunde câinele. El rămâne ascuns cât aștepți.",
        "Un tap pe fluture aduce câinele înapoi. Butoanele rămân vizibile.",
        "Ascunde și arată din nou. Fără resetare și fără să atingi câinele."
      ],
      "success": "Iepurele ascunde. Fluturele arată. Câinele poate primi mesaje și ascuns."
    }
  ],

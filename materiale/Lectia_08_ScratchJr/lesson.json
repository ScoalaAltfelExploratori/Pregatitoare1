  "missions": [
    {
      "label": "Misiunea 1",
      "title": "Artistul neobosit",
      "subtitle": "O rutină care continuă singură.",
      "diagram": "endless",
      "steps": [
        "La steag, iepurele devine mare, așteaptă, revine la normal și așteaptă din nou.",
        "Rutina continuă fără alte atingeri. Privește cel puțin trei runde.",
        "Mărimea mare rămâne aceeași. Încheie proba din butonul general de oprire."
      ],
      "success": "Trei runde și încă una. Dimensiunea nu se acumulează."
    },
    {
      "label": "Misiunea 2",
      "title": "Fiecare cu pauza lui",
      "subtitle": "Un artist îngheață. Celălalt continuă.",
      "diagram": "individual",
      "steps": [
        "Steagul pornește iepurele mare-normal și câinele mic-normal.",
        "Atinge iepurele: îngheață, dar câinele continuă. Apoi oprește și câinele prin atingere.",
        "Un nou steag îi repornește pe amândoi, fără Reset."
      ],
      "success": "Poți opri fiecare artist separat, în timp ce celălalt continuă."
    },
    {
      "label": "Misiunea 3 - dificilă",
      "title": "Regizorul statuilor",
      "subtitle": "Pornește. Îngheață. Pornește din nou.",
      "diagram": "remote",
      "steps": [
        "Fluturele pornește amândoi artiștii. Mingea îi îngheață pe amândoi.",
        "Folosește două culori de mesaj. Fiecare artist trebuie să primească ambele comenzi.",
        "Fluture → minge → fluture → minge. Fără Reset sau oprirea din bara aplicației."
      ],
      "success": "Amândoi pornesc și îngheață de două ori, numai prin butoanele tale."
    },
    {
      "label": "Rezervă 1 - 6-8 minute",
      "title": "Trei ipostaze",
      "subtitle": "Alege o stare și prinde momentul.",
      "diagram": "poses",
      "steps": [
        "Iepurele trece mereu prin trei stări: normal, mare, mic, cu pauze vizibile.",
        "Atinge iepurele când este mare. Trebuie să rămână înghețat în acea stare.",
        "Un nou steag începe rutina de la normal. Partenerul poate alege altă stare."
      ],
      "success": "Vedem trei ipostaze. Poți îngheța una și apoi reporni."
    },
    {
      "label": "Rezervă 2 - 8-10 minute",
      "title": "Cortina automată",
      "subtitle": "Un tap pornește și artiștii, și cronometrul.",
      "diagram": "timer",
      "steps": [
        "Un tap pe fluture pornește ambii artiști și mingea-cronometru.",
        "După o pauză, mingea trimite singură mesajul de înghețare. Nu o atingem.",
        "Artiștii rămân opriți. Un nou tap pe fluture repetă spectacolul."
      ],
      "success": "O singură atingere: pornire, spectacol, înghețare automată."
    }
  ]
}

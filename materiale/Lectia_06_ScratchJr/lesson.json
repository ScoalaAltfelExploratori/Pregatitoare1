    {
      "label": "Misiunea 1",
      "title": "Trezește paznicul",
      "subtitle": "Un steag. O întâlnire. O reacție.",
      "diagram": "guard",
      "steps": [
        "Iepurele ajunge la câine. Nu atingem câinele cu degetul.",
        "La contact, câinele spune Pop și urcă, eliberând drumul.",
        "Se aude un singur Pop. Reset și încă o probă."
      ],
      "success": "Câinele așteaptă contactul, apoi se separă de iepure."
    },
    {
      "label": "Misiunea 2",
      "title": "Două vizite",
      "subtitle": "Cine este întâlnit primul?",
      "diagram": "visits",
      "steps": [
        "Iepurele merge mai întâi la câine, apoi la fluture.",
        "Câinele spune Pop și urcă. Fluturele urcă fără sunet.",
        "Un singur steag, două reacții în ordinea întâlnirilor."
      ],
      "success": "Nimeni nu reacționează înainte să fie atins pe scenă."
    },
    {
      "label": "Misiunea 3 - dificilă",
      "title": "Reacția în lanț",
      "subtitle": "Iepure → câine → fluture",
      "diagram": "chain",
      "steps": [
        "Iepurele ajunge la câine, pe traseul scurt.",
        "Câinele merge la fluture, apoi coboară ca să se separe.",
        "Fluturele spune Pop și urcă. Un steag, fără mesaje sau alte atingeri."
      ],
      "success": "Reacția trece prin trei personaje și se oprește. Reset și repetă."
    },
    {
      "label": "Rezervă 1 - 6-8 minute",
      "title": "Comoara",
      "subtitle": "Mingea devine o comoară de adunat.",
      "diagram": "treasure",
      "steps": [
        "Un steag duce iepurele până la minge.",
        "La contact: un Pop, apoi mingea dispare.",
        "Reset aduce comoara înapoi. Încearcă din nou."
      ],
      "success": "Mingea reacționează la contact, fără să o atingi cu degetul."
    },
    {
      "label": "Rezervă 2 - 8-10 minute",
      "title": "Alarma la distanță",
      "subtitle": "Contact aproape. Semnal departe.",
      "diagram": "alarm",
      "steps": [
        "Iepurele atinge câinele. Câinele urcă și trimite un mesaj.",
        "Fluturele aflat sus crește, așteaptă, apoi revine la mărimea inițială.",
        "Nimeni nu atinge fluturele. Reset și încă o probă."
      ],
      "success": "Contactul pornește câinele. Mesajul pornește fluturele."
    }
  ]

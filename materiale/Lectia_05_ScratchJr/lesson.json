  "missions": [
    {
      "label": "Misiunea 1",
      "title": "Codul secret",
      "subtitle": "Ascultă. Bate din palme. Construiește.",
      "diagram": "secret",
      "steps": [
        "La un tap pe iepure se aud două Pop apropiate, o pauză mai lungă, apoi încă un Pop.",
        "Sunt exact trei sunete. După al treilea, programul se oprește singur.",
        "Ascultă din nou fără resetare. Ritmul trebuie să rămână același."
      ],
      "success": "Două apropiate, pauză lungă, unul. Exact trei Pop."
    },
    {
      "label": "Misiunea 2",
      "title": "Patru sunete, două ritmuri",
      "subtitle": "Același număr de Pop. Altă grupare.",
      "diagram": "four",
      "steps": [
        "Iepurele: patru Pop cu pauze egale între ele.",
        "Câinele: două perechi de Pop; pauza dintre perechi este mai lungă.",
        "Folosește Repeat la fiecare. Atinge pe rând; celălalt personaj nu cântă."
      ],
      "success": "Fiecare are patru sunete. Ritmurile se deosebesc prin pauze."
    },
    {
      "label": "Misiunea 3 - dificilă",
      "title": "Salutul secret",
      "subtitle": "O atingere. Trei perechi. Un singur răspuns.",
      "diagram": "handshake",
      "steps": [
        "Iepurele cântă trei perechi de Pop, cu pauze lungi între perechi. Folosește Repeat.",
        "După ultima pereche și o pauză lungă, câinele răspunde cu un singur Pop, pornit prin mesaj.",
        "Exact șapte sunete. Nicio altă atingere. Se oprește și se poate repeta."
      ],
      "success": "6 Pop de la iepure + 1 Pop de la câine. Mesajul vine după Repeat."
    },
    {
      "label": "Rezervă 1 - 6-8 minute",
      "title": "Ecoul",
      "subtitle": "Iepurele spune codul. Câinele îl repetă.",
      "diagram": "echo",
      "steps": [
        "Iepurele cântă codul: două Pop apropiate, o pauză lungă, unul.",
        "După o pauză lungă, câinele repetă exact același cod. Folosește un mesaj.",
        "Un singur tap pornește totul. Șase sunete, pe rând, apoi liniște."
      ],
      "success": "Același ritm de trei sunete se aude de două ori, fără suprapunere."
    },
    {
      "label": "Rezervă 2 - 8-10 minute",
      "title": "Șapte sunete, două blocuri",
      "subtitle": "Numără sunetele. Numără blocurile verzi.",
      "diagram": "seven",
      "steps": [
        "La un singur tap se aud exact șapte Pop, apoi programul se oprește.",
        "Folosește exact două blocuri Pop și un singur Repeat, într-un program al iepurelui.",
        "Pauzele sunt permise. Fără alte personaje sau mesaje. Arată ce se repetă și ce rămâne afară."
      ],
      "success": "Șapte sunete auzite. Numai două blocuri Pop în program."
    }
  ],
